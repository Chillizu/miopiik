{
  "name": "miopiik-dsh",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MiOpIIk host bundle — Mind / Ink / Operator: conversation and background action as two timelines over one log.",
  "license": "MIT",
  "main": "index.js",
  "engines": {
    "node": ">=23.6"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
