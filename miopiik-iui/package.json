{
  "name": "miopiik-iui",
  "version": "0.1.0-rc.4",
  "type": "module",
  "description": "MiOpIIk IUI — trusted native Markdown embeds for DeepSeek Harness",
  "license": "MIT",
  "main": "index.js",
  "engines": {
    "node": ">=23.6"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "icon.svg",
    "index.js",
    "client.js",
    "renderer.js",
    "settings.js",
    "shared/",
    "tools/",
    "patches/",
    "locale/*.json",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "miopiik",
    "iui",
    "markdown",
    "declarative-ui"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Chillizu/miopiik.git",
    "directory": "miopiik-iui"
  },
  "homepage": "https://github.com/Chillizu/miopiik",
  "bugs": {
    "url": "https://github.com/Chillizu/miopiik/issues"
  }
}
